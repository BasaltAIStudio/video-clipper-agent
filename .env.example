# Video Clipper Agent — .env.example
#
# Copy to `.env` and fill in the keys. No secrets are in this file; the real
# `.env` is created by the user and is never committed.

# ---------------------------------------------------------------------------
# LLM providers (free tier models)
# ---------------------------------------------------------------------------
# OpenRouter (free tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# NVIDIA NIM (free tier)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=google/gemini-2.0-flash-001

# LLM provider toggle
#   openrouter | nvidia_nim | none (heuristic-only, zero cost/rate-limit risk)
LLM_PROVIDER=openrouter

# ---------------------------------------------------------------------------
# Server / runtime
# ---------------------------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ---------------------------------------------------------------------------
# Transcription (local, offline)
# ---------------------------------------------------------------------------
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto

# ---------------------------------------------------------------------------
# Video processing
# ---------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
DEFAULT_ASPECT=9:16
TARGET_WIDTH=1080

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
DEFAULT_NUM_CLIPS=3
MAX_NUM_CLIPS=10
MIN_CLIP_DURATION=15.0
MAX_CLIP_DURATION=180.0

# ---------------------------------------------------------------------------
# Campaign / n8n integration
# ---------------------------------------------------------------------------
# Only fires when the request payload has "submit": true.
